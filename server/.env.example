# Bloom Vercel Serverless Backend Environment Variables

# 1. Telegram Bot Settings (Get from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
TELEGRAM_BOT_NAME=BloomMusicAuthBot

# 2. Yandex OAuth Application (Create at https://oauth.yandex.ru/)
# Redirect URI should be: https://<your-vercel-domain>.vercel.app/api/yandex/callback
YANDEX_CLIENT_ID=your_yandex_client_id_here
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here

# 3. Mobile App URL Scheme for Deep Linking (default: bloom://auth)
APP_DEEP_LINK_SCHEME=bloom://auth
