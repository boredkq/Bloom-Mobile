<?xml version="1.0" encoding="utf-8"?>
<!-- The optimizer drops resources nothing references at release, and the
     notification icon has no references: Dart passes its name as a string and
     the audio plugin looks it up at runtime. Without it the first notification
     kills the process with "Invalid notification (no valid small icon)", on
     pressing play and only in release builds, since debug builds keep all
     resources. The heart icons are named the same way; without them the like
     button would lose its icon. -->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_bloom,@drawable/ic_notif_heart,@drawable/ic_notif_heart_filled" />
