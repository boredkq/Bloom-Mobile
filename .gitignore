# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# `adb bugreport` reports: they land in the project root and weigh tens of
# megabytes
bugreport-*.zip

# The untranslated keys list is written on every build, so it stays out of the
# repo
l10n-missing.json
